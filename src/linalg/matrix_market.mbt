///|
/// Helper to parse string to Int.
fn parse_simple_int(s : String) -> Int {
  let mut res = 0
  let mut is_neg = false
  let mut start = 0
  if s.length() > 0 && s[0] == '-' {
    is_neg = true
    start = 1
  } else if s.length() > 0 && s[0] == '+' {
    start = 1
  }
  for i in start..<s.length() {
    let c = s[i]
    if c >= '0' && c <= '9' {
      res = res * 10 + (c.to_int() - '0'.to_int())
    }
  }
  if is_neg {
    -res
  } else {
    res
  }
}

///|
/// Helper to parse string to Double.
fn parse_simple_double(s : String) -> Double {
  let mut int_part = 0.0
  let mut frac_part = 0.0
  let mut frac_div = 1.0
  let mut in_frac = false
  let mut is_neg = false
  let mut start = 0

  if s.length() > 0 && s[0] == '-' {
    is_neg = true
    start = 1
  } else if s.length() > 0 && s[0] == '+' {
    start = 1
  }

  for i in start..<s.length() {
    let c = s[i]
    if c == '.' {
      in_frac = true
    } else if c >= '0' && c <= '9' {
      let digit = (c.to_int() - '0'.to_int()).to_double()
      if in_frac {
        frac_div = frac_div * 10.0
        frac_part = frac_part + digit / frac_div
      } else {
        int_part = int_part * 10.0 + digit
      }
    }
  }

  let total = int_part + frac_part
  if is_neg {
    -total
  } else {
    total
  }
}

///|
/// Serializes a CSR matrix into standard Matrix Market Coordinate format string.
pub fn serialize_matrix_market(csr : CsrMatrix) -> String {
  let mut s = "%%MatrixMarket matrix coordinate real general\n"
  s = s + "% Generated by MoonBit Circuit Solver Matrix Engine\n"
  s = s +
    csr.rows.to_string() +
    " " +
    csr.cols.to_string() +
    " " +
    csr.nnz().to_string() +
    "\n"

  for r in 0..<csr.rows {
    let start = csr.row_ptr[r]
    let end = csr.row_ptr[r + 1]
    for p in start..<end {
      let c = csr.col_ind[p]
      let val = csr.values[p]
      // Matrix Market uses 1-based indexing
      s = s +
        (r + 1).to_string() +
        " " +
        (c + 1).to_string() +
        " " +
        val.to_string() +
        "\n"
    }
  }

  s
}

///|
/// Parses Matrix Market format string into CsrMatrix.
pub fn parse_matrix_market(content : String) -> CsrMatrix {
  let lines = content.split("\n").to_array()
  let mut num_rows = 0
  let mut num_cols = 0
  let mut header_found = false

  let builder_ref : Ref[SparseBuilder?] = { val: None }

  for i in 0..<lines.length() {
    let line = lines[i].trim()
    if line.length() == 0 || line.has_prefix("%") {
      continue
    }

    let parts = line
      .split(" ")
      .to_array()
      .filter(fn(p) { p.trim().length() > 0 })
    if !header_found {
      if parts.length() >= 3 {
        num_rows = parse_simple_int(parts[0].to_owned())
        num_cols = parse_simple_int(parts[1].to_owned())
        builder_ref.val = Some(SparseBuilder::new(num_rows, num_cols))
        header_found = true
      }
    } else if parts.length() >= 3 {
      let r = parse_simple_int(parts[0].to_owned()) - 1
      let c = parse_simple_int(parts[1].to_owned()) - 1
      let val = parse_simple_double(parts[2].to_owned())
      match builder_ref.val {
        Some(b) => b.add_entry(r, c, val)
        None => ()
      }
    }
  }

  match builder_ref.val {
    Some(b) => b.to_csr()
    None => SparseBuilder::new(num_rows, num_cols).to_csr()
  }
}
