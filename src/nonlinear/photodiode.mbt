///|
/// Parameters for Photodiode / Solar Cell Model.
pub struct PhotodiodeParams {
  i_photo : Double // Photocurrent generated by incident optical power (A, e.g. 100 uA)
  is_dark : Double // Dark reverse saturation current (A, e.g. 1.0 nA)
  n_ideal : Double // Diode ideality factor
  r_shunt : Double // Parallel shunt resistance (Ohms, e.g. 1.0 MOhm)
  r_series : Double // Series contact resistance (Ohms, e.g. 10 Ohms)
  cj0 : Double // Zero-bias junction capacitance (F, e.g. 20 pF)
  responsivity : Double // Optical responsivity (A / W, e.g. 0.65 A/W at 850nm)
} derive(Eq, Debug)

///|
/// Default silicon PIN photodiode (e.g. BPW34) parameters.
pub fn PhotodiodeParams::default_pin() -> PhotodiodeParams {
  {
    i_photo: 50.0e-6,
    is_dark: 2.0e-9,
    n_ideal: 1.1,
    r_shunt: 1.0e7,
    r_series: 5.0,
    cj0: 25.0e-12,
    responsivity: 0.62,
  }
}

///|
/// Evaluates total terminal current and linearized conductance of photodiode at operating voltage Vd:
/// I = I_dark * (exp(Vd / nVt) - 1) + Vd / R_sh - I_photo
pub fn evaluate_photodiode(
  p : PhotodiodeParams,
  vd : Double,
  vt : Double,
) -> (Double, Double) {
  let nv_t = p.n_ideal * vt
  let exp_arg = vd / nv_t
  let safe_exp = @math.exp(
    if exp_arg > 35.0 {
      35.0
    } else if exp_arg < -35.0 {
      -35.0
    } else {
      exp_arg
    },
  )

  let i_diode = p.is_dark * (safe_exp - 1.0)
  let g_diode = p.is_dark * safe_exp / nv_t

  let g_sh = 1.0 / (if p.r_shunt > 1.0 { p.r_shunt } else { 1.0 })
  let i_sh = vd * g_sh

  let total_i = i_diode + i_sh - p.i_photo
  let total_g = g_diode + g_sh

  (total_i, total_g)
}
